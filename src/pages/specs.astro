---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../config/site.config.js';

const c = site.pageCopy.specs;
const groupOrder = c.groupOrder;

// ⚠️ EACH ROW CARRIES ITS OWN POSITION, for the same reason the gallery does:
// the table is grouped and sorted, so the loop index is not the row's position
// in the content, and a specification is addressed by position. Editing by the
// loop index would put a corrected engine-hour figure on a different row.
const specsByGroup = site.specs
	.map((s, n) => ({ ...s, n }))
	.sort((a, b) => a.order - b.order)
	.reduce((groups, spec) => {
		if (!groups[spec.group]) groups[spec.group] = [];
		groups[spec.group].push(spec);
		return groups;
	}, {} as Record<string, Array<{ label: string; value: string; n: number }>>);

const sortedGroups = Object.entries(specsByGroup).sort(([a], [b]) => {
	const ai = groupOrder.indexOf(a);
	const bi = groupOrder.indexOf(b);
	return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
});

// ── the equipment inventory ────────────────────────────────────────────────
//
// 214 lines of part numbers, engine hours, tank capacities and service dates,
// in sixteen sections. They were written straight into this template, which
// means nobody but us could correct one — on the page where being wrong matters
// most, because a buyer reads a specification as a promise.
//
// They are `block` rows now: one per section, each with its own children. A
// line's stored value is the exact inner HTML it already had, `<span>` badges
// and `&amp;` entities included, so set:html below reproduces the list byte for
// byte rather than approximately.
//
// An `<h3>` sits in the same flow as the lines (one section has "Steering
// System" halfway down), so a section's items are a single ordered list of
// `{ t: 'li' | 'h3' }` and consecutive lines are regrouped into a `<ul>` here.
// Storing two parallel lists instead would make "move this line above that
// sub-heading" impossible to express.
// ⚠️ THE "New" BADGE IS A FIELD, NOT MARKUP IN THE LINE, and it is a field
// because of how Astro scopes CSS. The badge started life as
// `<span class="s-equip__badge s-equip__badge--new">New</span>` typed inside 34
// of these list items. Stored as inner HTML and rendered with set:html it comes
// out WITHOUT Astro's `data-astro-cid-…` attribute — Astro can only add that to
// elements it compiles, not to a string — and the rule in this file's <style>
// block is `.s-equip__badge[data-astro-cid-…]`, so all 34 badges rendered
// unstyled. The before/after HTML diff is what caught it; nothing on the page
// would have thrown.
//
// Lifting it out fixes the painting and is also the better model: "this item is
// new" is a fact about the item, not a span, and it means a line's stored value
// is plain words — so src/config/editable.js can give it a `text` rule and a
// client cannot put markup on this page by typing it.
type EquipItem = { t: 'li' | 'h3'; v: string; badge?: string };
// ⚠️ EACH ITEM KEEPS ITS INDEX IN THE SECTION'S LIST. The grouping below turns
// one flat list into alternating sub-headings and <ul> runs, so a line's
// position inside its run is not its position in the content — and that is the
// position the editor addresses it by. Carrying `i` through is what makes
// editing the fourth line of the second run write the fourth line of the second
// run, rather than the second line of the section.
const runs = (items: EquipItem[]) => {
	const out: Array<{ t: 'h3'; v: string; i: number } | { t: 'ul'; lines: Array<EquipItem & { i: number }> }> = [];
	items.forEach((it, i) => {
		if (it.t === 'h3') { out.push({ t: 'h3', v: it.v, i }); return; }
		const last = out[out.length - 1];
		if (last && last.t === 'ul') last.lines.push({ ...it, i });
		else out.push({ t: 'ul', lines: [{ ...it, i }] });
	});
	return out;
};
const equipment = site.equipment.map((s) => ({ ...s, runs: runs(s.items as EquipItem[]) }));
---

<BaseLayout title={c.title} description={c.description}>

	<section class="page-header" data-rp-section="specsHeader" data-rp-section-name="The opening">
		<div class="wrap">
			<p class="eyebrow" data-rp-field="pageCopy.specs.eyebrow" data-rp-kind="text" data-rp-label="Eyebrow">{c.eyebrow}</p>
			<h1 data-rp-field="pageCopy.specs.h1" data-rp-kind="text" data-rp-label="Heading">{c.h1}</h1>
			<p class="page-header__sub" data-rp-field="pageCopy.specs.sub" data-rp-kind="text" data-rp-label="Opening line">{c.sub}</p>
			{/* The link points at a PDF built from these same specifications, so
			    its destination is not a field. The words on the button are. */}
			<a href={c.downloadHref} class="btn btn--outline specs-download" target="_blank" rel="noopener"
				data-rp-field="pageCopy.specs.downloadLabel" data-rp-kind="text" data-rp-label="Button">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
				{c.downloadLabel}
			</a>
		</div>
	</section>

	<!-- Quick-jump nav -->
	{/* The jump bar. Each destination is an anchor in this page's own markup, so
	    the LABEL is a field and the `href` is not: a typo in one scrolls
	    nowhere and nothing says why. */}
	<nav class="s-jump" data-rp-section="specsJump" data-rp-section-name="The jump bar">
		<div class="s-jump__inner">
			{c.jump.map((j: { href: string; label: string }, i: number) => (
				<a href={j.href} data-rp-field={`pageCopy.specs.jump.${i}.label`} data-rp-kind="text" data-rp-label="Link">{j.label}</a>
			))}
		</div>
	</nav>

	<!-- SPECS TABLES -->
	{/* ⚠️ THE FACTS A BUYER RELIES ON. Every one of them is editable, because
	    the owner is the only person who knows when one changes, and the limits
	    in src/config/editable.js are generous because a value here is often a
	    sentence. The GROUP heading counts itself: it is the name of a group the
	    rows are filed under, so renaming it here would empty the group. */}
	<section class="s-specs" id="specs" data-rp-section="specsTable" data-rp-section-name="The specifications"
		data-rp-list="specs" data-rp-label="The table">
		<div class="wrap s-specs__inner">
			{sortedGroups.map(([group, specs]) => (
				<div class="s-specs__group">
					<h2 class="s-specs__group-title" data-rp-auto data-rp-label="The group these rows are filed under">{group}</h2>
					<table class="s-specs__table">
						<tbody>
							{specs.map((spec) => (
								<tr data-rp-item={`specs.${spec.n}`}>
									<td class="s-specs__label" data-rp-field={`specs.${spec.n}.label`} data-rp-kind="text" data-rp-label="Label">{spec.label}</td>
									<td class="s-specs__value" data-rp-field={`specs.${spec.n}.value`} data-rp-kind="text" data-rp-label="Value">{spec.value}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			))}
		</div>
	</section>

	<!-- LAYOUT DIAGRAM -->
	<section class="s-layout" id="layout" data-rp-section="specsLayout" data-rp-section-name="The deck plan">
		<div class="wrap">
			<h2 class="s-layout__title" data-rp-field="pageCopy.specs.layout.heading" data-rp-kind="text" data-rp-label="Heading">{c.layout.heading}</h2>
			<figure class="s-layout__figure">
				{/* A drawn deck plan rather than a photograph: replacing it means
				    drawing another one, so the file is fixed and its description
				    and caption are fields. */}
				<img src={c.layout.image} alt={c.layout.alt} loading="lazy"
					data-rp-fixed="diagram" data-rp-label="The deck plan drawing" />
				<figcaption data-rp-field="pageCopy.specs.layout.caption" data-rp-kind="rich" data-rp-label="Caption">{c.layout.caption}</figcaption>
			</figure>
		</div>
	</section>

	<!-- EQUIPMENT INVENTORY -->
	{/* ⚠️ 214 LINES OF EQUIPMENT, ALL EDITABLE. Each line is addressed by the
	    position of its section and its own position in that section, which is
	    what `n` and the inner index carry; a sub-heading inside a section is
	    part of the same list, so it is addressed the same way. Adding or
	    removing a SECTION is a build, because a section's id is what the jump
	    bar above points at. */}
	<section class="s-equip" data-rp-section="specsEquipment" data-rp-section-name="The equipment inventory">
		<div class="wrap s-equip__inner">
			{equipment.map((sec, n) => (
				<div class="s-equip__section" id={sec.id} data-rp-item={`equipment.${n}`}>
					<h2 data-rp-field={`equipment.${n}.heading`} data-rp-kind="text" data-rp-label="Heading">{sec.heading}</h2>
					{sec.note && <p class="s-equip__note" data-rp-field={`equipment.${n}.note`} data-rp-kind="rich" data-rp-label="Note">{sec.note}</p>}
					{sec.runs.map((run) => (
						run.t === 'h3'
							? <h3 data-rp-field={`equipment.${n}.items.${run.i}.v`} data-rp-kind="text" data-rp-label="Sub-heading">{run.v}</h3>
							: <ul data-rp-list={`equipment.${n}.items`} data-rp-label="The list">{run.lines.map((line) => (
									<li data-rp-item={`equipment.${n}.items.${line.i}`}>
										<span data-rp-field={`equipment.${n}.items.${line.i}.v`} data-rp-kind="text" data-rp-label="Line">{line.v}</span>
										{line.badge && <Fragment>{' '}<span class="s-equip__badge s-equip__badge--new" data-rp-field={`equipment.${n}.items.${line.i}.badge`} data-rp-kind="text" data-rp-label="Badge">{line.badge}</span></Fragment>}
									</li>
								))}</ul>
					))}
				</div>
			))}
		</div>
	</section>

	<section class="s-cta-link" data-rp-section="specsCta" data-rp-section-name="The link to the features">
		<div class="wrap s-cta-link__inner">
			<p data-rp-field="pageCopy.specs.ctaBody" data-rp-kind="rich" data-rp-label="Paragraph">{c.ctaBody}</p>
			<a href={c.ctaHref} class="btn btn--primary" data-rp-field="pageCopy.specs.ctaLabel" data-rp-kind="text" data-rp-label="Button">{c.ctaLabel}</a>
		</div>
	</section>

</BaseLayout>

<style>
	.wrap {
		max-width: 1280px;
		margin: 0 auto;
		padding-left: var(--gap-l);
		padding-right: var(--gap-l);
	}

	.page-header {
		padding-top: clamp(80px, 14vw, 120px);
		padding-bottom: var(--gap-l);
		background: var(--color-bg-warm);
	}

	.page-header h1 {
		font-size: clamp(2rem, 7vw, 3.5rem);
		font-weight: 600;
		margin-top: var(--gap-s);
		margin-bottom: var(--gap-s);
	}

	.page-header__sub {
		font-size: var(--text-md);
		color: var(--color-text-muted);
		max-width: 60ch;
		margin: 0;
	}

	/* =============================================
	   JUMP NAV
	   ============================================= */
	.s-jump {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(255,255,255,0.92);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border-bottom: 1px solid var(--color-border-light);
	}

	.s-jump__inner {
		max-width: 1280px;
		margin: 0 auto;
		padding: 14px var(--gap-l);
		-webkit-overflow-scrolling: touch;
		display: flex;
		gap: 24px;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
	}

	.s-jump__inner::-webkit-scrollbar {
		display: none;
	}

	.s-jump__inner a {
		font-family: var(--font-body);
		font-size: var(--text-xs);
		font-weight: 500;
		color: var(--color-text-muted);
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.2s;
	}

	.s-jump__inner a:hover {
		color: var(--color-heading);
	}

	/* =============================================
	   SPECS TABLES
	   ============================================= */
	.s-specs {
		padding: var(--gap-l) 0;
	}

	.s-specs__inner {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--gap-m);
	}

	.s-specs__group {
		background: var(--color-bg);
		border: 1px solid var(--color-border-light);
		overflow: hidden;
	}

	.s-specs__group-title {
		font-family: var(--font-display);
		font-size: var(--text-xl);
		font-weight: 600;
		color: var(--color-heading);
		padding: var(--gap-m);
		margin: 0;
		border-bottom: 2px solid var(--color-accent);
	}

	.s-specs__table {
		width: 100%;
		border-collapse: collapse;
	}

	.s-specs__table tr {
		border-bottom: 1px solid var(--color-border-light);
	}

	.s-specs__table tr:last-child {
		border-bottom: none;
	}

	.s-specs__label {
		padding: 12px var(--gap-m);
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		font-weight: 500;
		width: 40%;
		vertical-align: top;
	}

	.s-specs__value {
		padding: 12px var(--gap-m);
		font-size: var(--text-sm);
		color: var(--color-heading);
		font-weight: 600;
	}

	/* =============================================
	   LAYOUT DIAGRAM
	   ============================================= */
	.s-layout {
		padding: var(--gap-l) 0;
		background: var(--color-bg-warm);
	}

	.s-layout__title {
		font-family: var(--font-display);
		font-size: clamp(1.6rem, 2.5vw, 2rem);
		font-weight: 600;
		text-align: center;
		margin: 0 0 var(--space-lg);
		color: var(--color-heading);
	}

	.s-layout__figure {
		margin: 0;
		text-align: center;
	}

	.s-layout__figure img {
		width: 100%;
		max-width: 1100px;
		height: auto;
		display: block;
		margin: 0 auto;
	}

	.s-layout__figure figcaption {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		max-width: 70ch;
		margin: var(--space-md) auto 0;
		line-height: 1.5;
	}

	/* =============================================
	   EQUIPMENT LISTS
	   ============================================= */
	.s-equip {
		padding: 0;
	}

	.s-equip__section {
		padding: var(--space-2xl) 0;
		border-bottom: 1px solid var(--color-border-light);
	}

	.s-equip__section:last-child {
		border-bottom: none;
	}

	.s-equip__section h2 {
		font-size: clamp(1.6rem, 2.5vw, 2rem);
		font-weight: 600;
		margin-bottom: var(--space-sm);
	}

	.s-equip__section h3 {
		font-size: var(--text-xl);
		font-weight: 600;
		margin-top: var(--space-xl);
		margin-bottom: var(--space-sm);
	}

	.s-equip__note {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		font-style: italic;
		margin-bottom: var(--space-lg);
		max-width: 70ch;
	}

	.s-equip__section ul {
		list-style: none;
		padding: 0;
		margin: 0;
		columns: 2;
		column-gap: var(--space-2xl);
	}

	.s-equip__section li {
		padding: 10px 0 10px 20px;
		position: relative;
		break-inside: avoid;
		font-size: var(--text-sm);
		color: var(--color-text);
		line-height: 1.5;
		border-bottom: 1px solid var(--color-border-light);
	}

	.s-equip__section li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 17px;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--color-accent);
	}

	/* Item badges */
	.s-equip__badge {
		display: inline-block;
		font-family: var(--font-body);
		font-size: 0.6rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 1px;
		padding: 2px 8px;
		border-radius: 100px;
		margin-left: 8px;
		vertical-align: middle;
	}

	.s-equip__badge--new {
		background: var(--color-accent);
		color: #fff;
	}

	.s-equip__badge--upgraded {
		background: var(--color-gold);
		color: #fff;
	}

	.specs-download {
		margin-top: var(--gap-m);
		display: inline-flex;
		align-items: center;
		gap: 8px;
	}

	.specs-download svg {
		flex-shrink: 0;
	}

	/* =============================================
	   CTA LINK
	   ============================================= */
	.s-cta-link {
		padding: var(--gap-l) 0;
	}

	.s-cta-link__inner {
		background: var(--color-bg-warm);
		padding: 60px;
		text-align: center;
	}

	.s-cta-link__inner p {
		font-size: var(--text-md);
		color: var(--color-text-muted);
		margin-bottom: var(--space-lg);
	}

	/* =============================================
	   RESPONSIVE
	   ============================================= */
	@media (max-width: 768px) {
		.s-page-header {
			padding-top: 100px;
			padding-bottom: 40px;
		}

		.s-specs__inner {
			grid-template-columns: 1fr;
		}

		.s-equip__section ul {
			columns: 1;
		}

		.s-cta-link__inner {
			padding: 40px 24px;
		}
	}
</style>
