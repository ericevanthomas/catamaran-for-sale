---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
	schema?: Record<string, unknown>;
}

const { title, description, image, schema } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} schema={schema} />
	  <!-- Remodeler Pilot analytics (first-party, DNT-respecting) -->
  <script defer src="https://rp-dashboard-cw0.pages.dev/t.js" data-site="catamaran"></script>
  <script defer src="https://rp-dashboard-cw0.pages.dev/rec.js" data-site="catamaran"></script>
</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
