<style>
	.feat-row { text-decoration: none; color: inherit; }

	/* =============================================
	   SALE STAMP — hand-drawn rope notation (top of left column)
	   Slow ambient rotation; on hover the rope speeds up + tightens
	   into focus. Type stays still — only the rope moves.
	   ============================================= */
	.sale-stamp {
		display: inline-grid;
		place-items: center;
		position: relative;
		width: 122px;
		aspect-ratio: 1 / 1;
		margin: 0 0 var(--gap-m);
		text-decoration: none;
		color: inherit;
	}

	/* Two-layer rope:
	   - Outer (.sale-stamp__rope): hover-triggered one-shot rubbery kick
	   - Inner (.sale-stamp__rope-spin): continuous ambient rotation
	   The two transforms compose, so the kick rides on top of the slow spin
	   without interrupting it. After the 0.75s kick, the outer is back at 0
	   and the inner keeps drifting at base speed. */
	.sale-stamp__rope {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-heading);
		opacity: 0.62;
		pointer-events: none;
		transform-origin: 50% 50%;
	}

	.sale-stamp__rope-spin {
		display: block;
		width: 100%;
		height: 100%;
		animation: sale-stamp-spin 45s linear infinite;
		transform-origin: 50% 50%;
		will-change: transform;
	}

	.sale-stamp__rope-spin :global(svg) {
		width: 100%;
		height: 100%;
		display: block;
	}
	.sale-stamp__rope-spin :global(svg path) {
		fill: currentColor;
	}

	@keyframes sale-stamp-spin {
		to { transform: rotate(360deg); }
	}

	/* Wind-up + burst: pull back counter-clockwise, then one sustained
	   clockwise burst that completes a full revolution and lands back at
	   visual zero. Only one direction change (the wind-up). After the kick,
	   the outer is at 0 (= 360) and the slow inner rotation continues. */
	.sale-stamp:hover .sale-stamp__rope {
		animation: sale-stamp-kick 0.75s forwards;
	}

	@keyframes sale-stamp-kick {
		0%   { transform: rotate(0deg);    animation-timing-function: cubic-bezier(0.4, 0, 0.5, 1); }
		28%  { transform: rotate(-16deg);  animation-timing-function: cubic-bezier(0.45, 0, 0.25, 1); }
		100% { transform: rotate(360deg); }
	}

	.sale-stamp__inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		gap: 6px;
		width: 64%;
	}

	.sale-stamp__title {
		font-family: var(--font-display);
		font-size: 17px;
		font-weight: 500;
		line-height: 1.02;
		color: var(--color-heading);
		letter-spacing: -0.005em;
	}
	.sale-stamp__title i {
		font-style: italic;
	}

	.sale-stamp__rule {
		display: block;
		width: 20px;
		height: 1px;
		background: var(--color-text-muted);
		opacity: 0.55;
	}

	.sale-stamp__link {
		font-family: var(--font-body);
		font-size: 8.5px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 1.4px;
		color: var(--color-accent);
		display: flex;
		flex-direction: column;
		align-items: center;
		line-height: 1.35;
	}

	@media (prefers-reduced-motion: reduce) {
		.sale-stamp__rope-spin,
		.sale-stamp:hover .sale-stamp__rope { animation: none; }
	}

	@media (max-width: 600px) {
		.sale-stamp { width: 110px; }
		.sale-stamp__title { font-size: 15px; }
	}
</style>

<script>
	// Photo lightbox
	const photoItems = document.querySelectorAll('.photos__item');
	const lightbox = document.getElementById('photo-lightbox') as HTMLDialogElement;
	const lbImg = lightbox.querySelector('.lightbox__img') as HTMLImageElement;
	const lbCounter = lightbox.querySelector('.lightbox__counter') as HTMLElement;
	const allPhotos = Array.from(photoItems);
	let currentIdx = 0;

	function showPhotoAt(idx: number) {
		currentIdx = (idx + allPhotos.length) % allPhotos.length;
		const img = allPhotos[currentIdx].querySelector('img') as HTMLImageElement;
		lbImg.src = img.src;
		lbImg.alt = img.alt;
		lbCounter.textContent = `${currentIdx + 1} / ${allPhotos.length}`;
	}

	photoItems.forEach((item, i) => {
		item.addEventListener('click', () => {
			showPhotoAt(i);
			lightbox.showModal();
		});
	});

	lightbox.querySelector('.lightbox__close')?.addEventListener('click', () => lightbox.close());
	lightbox.querySelector('.lightbox__prev')?.addEventListener('click', () => showPhotoAt(currentIdx - 1));
	lightbox.querySelector('.lightbox__next')?.addEventListener('click', () => showPhotoAt(currentIdx + 1));

	lightbox.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowLeft') showPhotoAt(currentIdx - 1);
		if (e.key === 'ArrowRight') showPhotoAt(currentIdx + 1);
		if (e.key === 'Escape') lightbox.close();
	});

	lightbox.addEventListener('click', (e) => {
		if (e.target === lightbox) lightbox.close();
	});
</script>
