---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { marked } from 'marked';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import site from '../config/site.config.js';
import heroBow from '../assets/home/hero-bow-edited.webp';
import kidsCockpit from '../assets/home/kids-cockpit.webp';
import tropicaliaAnchor from '../assets/home/tropicalia-anchor.webp';
import galleyWide from '../assets/home/galley-wide.webp';
import masterCabinQueen from '../assets/home/master-cabin-queen.webp';
import interior1 from '../assets/home/interior-1.webp';

// ⚠️ SIX PHOTOGRAPHS ON THIS PAGE GO THROUGH ASTRO'S OWN IMAGE SERVICE, not
// through <ResponsiveImage>, and they still do. `<Image>` with a static import
// emits hashed /_astro/ files at widths and a quality chosen per placement; the
// rest of the site uses the /_img/ pipeline in scripts/optimize-images.mjs.
// Moving these onto the other pipeline would have changed every src and srcset
// on the home page — a visible rewrite of the page to make a sentence about
// tidiness true — so the two pipelines stay side by side.
//
// What that costs is that the FILE is chosen in this template and cannot be
// swapped by the owner; what it does not cost is the words. The ALT TEXT is
// content and comes out of the database like everything else, and these entries
// are mapped `data-rp-fixed` in mappings/index.json so pressing one opens a
// drawer that says why and offers to have us change it, rather than doing
// nothing (EDITOR-RULES: no element is dead).
const IMPORTED: Record<string, ImageMetadata> = {
	'/images/hero-bow-edited.webp': heroBow,
	'/images/home/kids-cockpit.webp': kidsCockpit,
	'/images/home/tropicalia-anchor.webp': tropicaliaAnchor,
	'/images/home/galley-wide.webp': galleyWide,
	'/images/home/master-cabin-queen.webp': masterCabinQueen,
	'/images/home/interior-1.webp': interior1,
};

const md = (s?: string) => s ? marked.parseInline(s, { async: false }) as string : '';

const ropeSvg = readFileSync(
	resolve(process.cwd(), 'public/images/icons/rope-circle.svg'),
	'utf-8'
)
	.replace(/<\?xml[^?]*\?>/g, '')
	.replace(/<!--[\s\S]*?-->/g, '')
	.trim();

const hero = site.hero;
const glance = site.glance;
const whyChose = site.whyChose;
const upgradesSection = site.upgradesSection;
const highlights = site.highlights;
const bottomCta = site.bottomCta;
const alternatingSections = site.alternatingSections;
const topPhotos = site.topPhotos;
const bottomPhotos = site.bottomPhotos;
const stamp = site.saleStamp;

const title = site.pageCopy.home.title;
const description = site.pageCopy.home.description;
---

<BaseLayout title={title} description={description}>

	<!-- HERO — split screen -->
	<section class="hero" data-rp-section="hero" data-rp-section-name="The opening">
		<div class="hero__text">
			<div class="hero__text-inner">
				<a href={stamp.href} class="sale-stamp" aria-label={stamp.ariaLabel}>
					<span class="sale-stamp__rope" aria-hidden="true">
						<span class="sale-stamp__rope-spin" set:html={ropeSvg}></span>
					</span>
					<span class="sale-stamp__inner">
						<span class="sale-stamp__title"><i data-rp-field="saleStamp.title" data-rp-kind="text" data-rp-label="Stamp">{stamp.title}</i></span>
						<span class="sale-stamp__rule" aria-hidden="true"></span>
						<span class="sale-stamp__link">
							{stamp.linkWords.map((w: string, i: number) => (
								<span data-rp-field={`saleStamp.linkWords.${i}`} data-rp-kind="text" data-rp-label="Word">{w}</span>
							))}
						</span>
					</span>
				</a>

				<p class="eyebrow" data-rp-field="hero.eyebrow" data-rp-kind="text" data-rp-label="Eyebrow">{hero.eyebrow}</p>
				{/* Three lines with a break between them, because the type is set
				    to break there. The one-line `hero.headline` beside it in the
				    content is what the share cards and the structured data use,
				    and it is editable where it is rendered — in the page title —
				    so neither is a field that saves and appears to do nothing. */}
				<h1>{hero.headlineLines.map((line: string, i: number, arr: string[]) => (
					<>
						<span data-rp-field={`hero.headlineLines.${i}`} data-rp-kind="text" data-rp-label="Line">{line}</span>
						{i < arr.length - 1 && <br />}
					</>
				))}</h1>
				<p class="hero__sub">
					<span data-rp-field="glance.priceDisplay" data-rp-kind="text" data-rp-label="Price line">{glance.priceDisplay}</span><br />
					<span data-rp-field="glance.locationDisplay" data-rp-kind="text" data-rp-label="Status line">{glance.locationDisplay}</span>
				</p>
				<a href={hero.ctaLink} class="btn btn--primary" data-rp-field="hero.ctaText" data-rp-kind="text" data-rp-label="Button">{hero.ctaText}</a>
			</div>
		</div>
		<div class="hero__image">
			<Image
				src={IMPORTED[hero.photo]}
				alt={hero.photoAlt}
				widths={[400, 600, 800, 1000, 1280, 1600]}
				sizes="(min-width: 900px) 50vw, 100vw"
				loading="eager"
				fetchpriority="high"
				decoding="async"
			 quality={60} data-rp-fixed="photo" data-rp-label="The opening photograph"/>
		</div>
	</section>

	<!-- AT A GLANCE -->
	<section class="glance" data-rp-section="glance" data-rp-section-name="At a glance">
		<div class="wrap">
			<div class="glance__grid" data-rp-list="glance.items" data-rp-label="The table">
				{glance.items.map((item: { label: string; value: string }, i: number) => (
					<div class="glance__item" data-rp-item={`glance.items.${i}`}>
						<span class="glance__label" data-rp-field={`glance.items.${i}.label`} data-rp-kind="text" data-rp-label="Label">{item.label}</span>
						<span class="glance__value" data-rp-field={`glance.items.${i}.value`} data-rp-kind="text" data-rp-label="Value">{item.value}</span>
					</div>
				))}
			</div>
			{(glance.note || glance.linkText) && (
				<div class="glance__footer">
					{glance.note && <p class="glance__note" data-rp-field="glance.note" data-rp-kind="rich" data-rp-label="Note">{glance.note}</p>}
					{glance.linkText && glance.linkUrl && (
						<div class="glance__links">
							<a href={glance.linkUrl}><span data-rp-field="glance.linkText" data-rp-kind="text" data-rp-label="Link">{glance.linkText}</span> →</a>
						</div>
					)}
				</div>
			)}
		</div>
	</section>

	<!-- PHOTOS -->
	<section class="photos" data-rp-section="topPhotos" data-rp-section-name="The three photographs">
		<div class="photos__grid" data-rp-list="topPhotos" data-rp-label="The three photographs">
			{topPhotos.map((photo: { image: string; alt: string }, i: number) => (
				<div class:list={['photos__item', { 'photos__item--wide': i === 0 }]} data-photo-idx={i}
					data-rp-item={`topPhotos.${i}`}>
					<ResponsiveImage
						src={photo.image}
						alt={photo.alt}
						sizes={i === 0 ? '(min-width: 900px) 66vw, 100vw' : '(min-width: 900px) 33vw, 100vw'}
						loading="lazy"
						data-rp-field={`topPhotos.${i}.image`}
						data-rp-kind="image"
						data-rp-label="Photograph"
					/>
				</div>
			))}
		</div>
		<div class="photos__footer">
			<a href={site.photosMore.href} class="photos__more" data-rp-field="photosMore.label" data-rp-kind="text" data-rp-label="Link">{site.photosMore.label}</a>
		</div>
		<!-- Photo lightbox -->
		<dialog class="lightbox" id="photo-lightbox">
			<button class="lightbox__close" aria-label="Close">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
			</button>
			<button class="lightbox__prev" aria-label="Previous">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
			</button>
			<button class="lightbox__next" aria-label="Next">
				<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="9 6 15 12 9 18"/></svg>
			</button>
			<div class="lightbox__img-wrap">
				<img class="lightbox__img" src="" alt="" data-rp-auto data-rp-label="The photograph you are looking at" />
			</div>
			<div class="lightbox__counter"></div>
		</dialog>
	</section>

	<!-- WHY WE CHOSE THIS BOAT — intro -->
	<section class="features-intro" data-rp-section="whyChose" data-rp-section-name="Why you chose this boat">
		<div class="wrap">
			<div class="features-intro__grid">
				<div class="features-intro__text">
					<p class="eyebrow" data-rp-field="whyChose.eyebrow" data-rp-kind="text" data-rp-label="Eyebrow">{whyChose.eyebrow}</p>
					<h2 data-rp-field="whyChose.heading" data-rp-kind="text" data-rp-label="Heading">{whyChose.heading}</h2>
					<p data-rp-field="whyChose.body" data-rp-kind="rich" data-rp-label="Paragraph" set:html={md(whyChose.body)}></p>
				</div>
				<div class="features-intro__photo">
					<Image src={IMPORTED[whyChose.photo]} alt={whyChose.photoAlt} widths={[480, 720, 960, 1280]} sizes="(min-width: 900px) 50vw, 100vw" loading="lazy"  quality={68} data-rp-fixed="photo" data-rp-label="The family photograph"/>
				</div>
			</div>
		</div>
	</section>

	<!-- ALTERNATING STORY SECTIONS — full-bleed -->
	{alternatingSections.map((section: { eyebrow: string; heading: string; body: string; image: string }, i: number) => (
		<section class:list={['feat-row', { 'feat-row--reverse': i % 2 === 1 }]}
			data-rp-section={`alternating-${i}`} data-rp-section-name={`Story row ${i + 1}`}
			data-rp-item={`alternatingSections.${i}`}>
			<div class="feat-row__image">
				{section.image && (
					<ResponsiveImage
						src={section.image}
						alt={section.heading}
						sizes="(min-width: 900px) 50vw, 100vw"
						loading="lazy"
						data-rp-field={`alternatingSections.${i}.image`}
						data-rp-kind="image"
						data-rp-label="Photograph"
					/>
				)}
			</div>
			<div class="feat-row__content">
				<div class="feat-row__inner">
					<span class="card__cat" data-rp-field={`alternatingSections.${i}.eyebrow`} data-rp-kind="text" data-rp-label="Eyebrow">{section.eyebrow}</span>
					<h3 data-rp-field={`alternatingSections.${i}.heading`} data-rp-kind="text" data-rp-label="Heading">{section.heading}</h3>
					<p data-rp-field={`alternatingSections.${i}.body`} data-rp-kind="rich" data-rp-label="Paragraph" set:html={md(section.body)}></p>
				</div>
			</div>
		</section>
	))}

	<section class="features-cta" data-rp-section="featuresCta" data-rp-section-name="The link to the features">
		<div class="wrap features-cta__inner">
			<a href={site.featuresCta.href} class="btn btn--outline" data-rp-field="featuresCta.label" data-rp-kind="text" data-rp-label="Button">{site.featuresCta.label}</a>
		</div>
	</section>

	<!-- RECENT UPGRADES — dark -->
	{upgradesSection.items.length > 0 && (
		<section class="upgrades" data-rp-section="upgrades" data-rp-section-name="Recent upgrades">
			<div class="wrap">
				<p class="upgrades__eyebrow" data-rp-field="upgradesSection.eyebrow" data-rp-kind="text" data-rp-label="Eyebrow">{upgradesSection.eyebrow}</p>
				<h2 class="upgrades__heading" data-rp-field="upgradesSection.heading" data-rp-kind="text" data-rp-label="Heading">{upgradesSection.heading}</h2>
				<div class="upgrades__grid" data-rp-list="upgradesSection.items" data-rp-label="The upgrades">
					{upgradesSection.items.map((item: { title: string; body: string }, i: number) => (
						<div class="upgrades__item" data-rp-item={`upgradesSection.items.${i}`}>
							<svg class="upgrades__icon" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="20 6 9 17 4 12"/></svg>
							<h3 data-rp-field={`upgradesSection.items.${i}.title`} data-rp-kind="text" data-rp-label="Upgrade">{item.title}</h3>
							<p data-rp-field={`upgradesSection.items.${i}.body`} data-rp-kind="rich" data-rp-label="What it is" set:html={md(item.body)}></p>
						</div>
					))}
				</div>
			</div>
		</section>
	)}

	<!-- BOTTOM PHOTO STRIP -->
	<section class="bottom-photos" data-rp-section="bottomPhotos" data-rp-section-name="The four photographs">
		<div class="wrap">
			<div class="bottom-photos__grid">
				{bottomPhotos.map((photo: { image: string; alt: string }, i: number) => (
					<div class="bottom-photos__item" data-rp-item={`bottomPhotos.${i}`}>
						<Image src={IMPORTED[photo.image]} alt={photo.alt} widths={[720, 1080, 1280]} sizes="(min-width: 1280px) 1200px, 100vw" loading="lazy" quality={72}
							data-rp-fixed="photo" data-rp-label="One of the four photographs"/>
					</div>
				))}
			</div>
			<div class="bottom-photos__footer">
				<a href={site.bottomPhotosMore.href} class="bottom-photos__more" data-rp-field="bottomPhotosMore.label" data-rp-kind="text" data-rp-label="Link">{site.bottomPhotosMore.label}</a>
			</div>
		</div>
	</section>

	<!-- KEY EQUIPMENT — what cruisers look for -->
	{highlights.bullets.length > 0 && (
		<section class="highlights" data-rp-section="highlights" data-rp-section-name="Key equipment">
			<div class="wrap">
				<div class="highlights__header">
					<p class="eyebrow" data-rp-field="highlights.eyebrow" data-rp-kind="text" data-rp-label="Eyebrow">{highlights.eyebrow}</p>
					<h2 data-rp-field="highlights.heading" data-rp-kind="text" data-rp-label="Heading">{highlights.heading}</h2>
				</div>
				<div class="highlights__grid" data-rp-list="highlights.bullets" data-rp-label="The list">
					{highlights.bullets.map((bullet: string, i: number) => (
						<div class="highlights__item" data-rp-item={`highlights.bullets.${i}`}>
							<svg class="highlights__check" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
							<span data-rp-field={`highlights.bullets.${i}`} data-rp-kind="text" data-rp-label="Line">{bullet}</span>
						</div>
					))}
				</div>
			</div>
		</section>
	)}

	<!-- CTA — dark -->
	<section class="cta" data-rp-section="bottomCta" data-rp-section-name="The invitation">
		<div class="wrap cta__inner">
			<h2 data-rp-field="bottomCta.headline" data-rp-kind="text" data-rp-label="Headline">{bottomCta.headline}</h2>
			<p data-rp-field="bottomCta.body" data-rp-kind="rich" data-rp-label="Paragraph" set:html={md(bottomCta.body)}></p>
			<div class="cta__buttons">
				<a href={bottomCta.primaryLink} class="btn btn--primary" data-rp-field="bottomCta.primaryText" data-rp-kind="text" data-rp-label="Button">{bottomCta.primaryText}</a>
				<a href={bottomCta.secondaryLink} class="btn btn--outline cta__outline" data-rp-field="bottomCta.secondaryText" data-rp-kind="text" data-rp-label="Button">{bottomCta.secondaryText}</a>
			</div>
		</div>
	</section>

</BaseLayout>

<style>
	/* =============================================
	   LAYOUT
	   ============================================= */
	.wrap {
		max-width: 1280px;
		margin: 0 auto;
		padding-left: var(--gap-l);
		padding-right: var(--gap-l);
	}

	/* =============================================
	   HERO — split screen
	   ============================================= */
	.hero {
		display: grid;
		grid-template-columns: 1fr 1fr;
		min-height: 100vh;
		max-height: 960px;
	}

	.hero__text {
		display: flex;
		align-items: center;
		padding: var(--size-12) var(--gap-l);
		background: var(--color-bg);
	}

	.hero__text-inner {
		max-width: 480px;
	}

	.hero__text h1 {
		font-size: clamp(2.8rem, 4.5vw, 4.2rem);
		font-weight: 600;
		line-height: 1;
		letter-spacing: -1px;
		margin: var(--gap-s) 0 var(--gap-m);
	}

	.hero__sub {
		font-size: var(--text-md);
		color: var(--color-text-muted);
		line-height: 1.6;
		margin-bottom: var(--gap-m);
	}

	.hero__image {
		overflow: hidden;
		position: relative;
	}

	.hero__image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* =============================================
	   AT A GLANCE
	   ============================================= */
	.glance {
		padding: var(--size-10) 0;
		background: var(--color-bg-warm);
	}

	.glance__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		column-gap: var(--gap-l);
		row-gap: 0;
	}

	.glance__item {
		padding: var(--size-4) 0;
		border-bottom: 1px solid var(--color-border);
	}

	/* Last row: no bottom border */
	.glance__item:nth-last-child(-n+4) {
		border-bottom: none;
	}

	/* Single-column mobile: restore bottom border on every item except the last */
	.glance__label {
		display: block;
		font-family: var(--font-body);
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--color-text-muted);
		text-transform: uppercase;
		letter-spacing: 1.5px;
		margin-bottom: 8px;
	}

	.glance__value {
		display: block;
		font-family: var(--font-body);
		font-size: 1.0625rem;
		font-weight: 600;
		color: var(--color-heading);
		line-height: 1.4;
		font-variant-numeric: tabular-nums;
		letter-spacing: -0.005em;
	}

	.glance__footer {
		margin-top: var(--gap-l);
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: var(--gap-l);
	}

	.glance__note {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		line-height: 1.6;
		max-width: 55ch;
		margin: 0;
	}

	.glance__links {
		display: flex;
		gap: var(--gap-m);
		flex-shrink: 0;
	}

	.glance__links a {
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--color-accent);
		white-space: nowrap;
	}

	/* =============================================
	   PHOTOS
	   ============================================= */
	.photos {
		padding: var(--size-9) 0;
		background: var(--color-bg);
	}

	.photos__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2px;
	}

	.photos__item {
		overflow: hidden;
		min-height: 0;
		min-width: 0;
		aspect-ratio: 4 / 3;
		position: relative;
		cursor: pointer;
	}

	.photos__item img {
		position: absolute;
		inset: 0;
		width: 100% !important;
		height: 100% !important;
		max-width: none;
		object-fit: cover;
		display: block;
		transition: transform 0.5s var(--ease);
	}

	.photos__item:hover img {
		transform: scale(1.03);
	}

	.photos__footer {
		text-align: right;
		padding: var(--gap-s) var(--gap-l) 0;
	}

	.photos__more {
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--color-accent);
	}

	/* Lightbox */
	.lightbox {
		border: none;
		background: rgba(0,0,0,0.95);
		padding: 0;
		max-width: 100vw;
		max-height: 100vh;
		z-index: 200;
	}

	.lightbox[open] {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.lightbox::backdrop { background: rgba(0,0,0,0.95); }

	.lightbox__img-wrap {
		max-width: 90vw;
		max-height: 85vh;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.lightbox__img {
		max-width: 100%;
		max-height: 85vh;
		object-fit: contain;
	}

	.lightbox__close,
	.lightbox__prev,
	.lightbox__next {
		position: fixed;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255,255,255,0.1);
		border: none;
		border-radius: 50%;
		cursor: pointer;
		color: #fff;
		transition: background 0.2s;
	}

	.lightbox__close { top: var(--gap-m); right: var(--gap-m); width: 44px; height: 44px; }
	.lightbox__prev, .lightbox__next { top: 50%; transform: translateY(-50%); width: 48px; height: 48px; }
	.lightbox__prev { left: var(--gap-m); }
	.lightbox__next { right: var(--gap-m); }
	.lightbox__close:hover, .lightbox__prev:hover, .lightbox__next:hover { background: rgba(255,255,255,0.2); }

	.lightbox__counter {
		position: fixed;
		top: var(--gap-m);
		left: var(--gap-m);
		color: rgba(255,255,255,0.5);
		font-size: var(--text-sm);
		font-weight: 500;
	}

	/* =============================================
	   FEATURES INTRO — warm bg
	   ============================================= */
	.features-intro {
		padding: var(--size-11) 0;
		background: var(--color-bg-warm);
	}

	.features-intro__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--gap-l);
		align-items: center;
	}

	.features-intro__text h2 {
		font-size: clamp(2rem, 3vw, 2.6rem);
		font-weight: 600;
		margin: var(--gap-s) 0 var(--gap-m);
	}

	.features-intro__text p {
