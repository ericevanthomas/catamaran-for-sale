---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../config/site.config.js';

const c = site.pageCopy.notFound;
---

<BaseLayout title={c.title} description={c.description}>
	<section class="not-found" data-rp-section="notFound" data-rp-section-name="The page nobody meant to find">
		<div class="wrap">
			<h1 data-rp-field="pageCopy.notFound.h1" data-rp-kind="text" data-rp-label="Heading">{c.h1}</h1>
			<p data-rp-field="pageCopy.notFound.body" data-rp-kind="text" data-rp-label="Line">{c.body}</p>
			<a href={c.ctaHref} class="btn btn--primary" data-rp-field="pageCopy.notFound.ctaLabel" data-rp-kind="text" data-rp-label="Button">{c.ctaLabel}</a>
		</div>
	</section>
</BaseLayout>

<style>
	.wrap {
		max-width: 1280px;
		margin: 0 auto;
		padding-left: var(--gap-l);
		padding-right: var(--gap-l);
	}

	.not-found {
		text-align: center;
		padding: var(--size-12) 0;
		min-height: 60vh;
		display: flex;
		align-items: center;
	}

	.not-found .wrap {
		width: 100%;
	}

	.not-found h1 {
		font-size: 8rem;
		color: var(--color-border);
		line-height: 1;
		margin-bottom: var(--gap-s);
	}

	.not-found p {
		color: var(--color-text-muted);
		font-size: var(--text-lg);
		margin-bottom: var(--gap-m);
	}

	@media (max-width: 600px) {
		.wrap { padding-left: var(--gap-m); padding-right: var(--gap-m); }
		.not-found h1 { font-size: 5rem; }
	}
</style>
