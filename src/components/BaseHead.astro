---
import '../styles/global.css';
import site from '../config/site.config.js';
import { IS_PROD } from '../lib/target.js';

interface Props {
	title: string;
	description: string;
	image?: string;
	schema?: Record<string, unknown>;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description, image, schema: extraSchema } = Astro.props;
const ogImageURL = image ? new URL(image, Astro.url) : new URL(site.seo.ogImage, Astro.site);

const SITE_URL = site.seo.siteUrl;
const p = site.seo.product;

// Product schema for the boat — emitted on every page.
//
// ⚠️ ITS SPECIFICATION LIST IS NOT THE SPECS TABLE, and the two say some things
// differently on purpose: this one says "Fuel: Diesel — 212 gal" where the table
// says "Diesel Fuel: 212 gal total across 3 tanks". They are the same fact
// written for two readers — a crawler and a buyer — and both were already on the
// page. Deriving one from the other would have changed what one of them says, so
// both moved into the database as what they are: `seo.product.properties` here,
// `specs` there.
const productSchema = {
	"@context": "https://schema.org",
	"@type": "Product",
	"@id": `${SITE_URL}#boat`,
	"name": p.name,
	"alternateName": p.alternateName,
	"description": p.description,
	"url": SITE_URL,
	"image": ogImageURL.href,
	"brand": { "@type": "Brand", "name": site.brand.builder },
	"manufacturer": { "@type": "Organization", "name": p.manufacturerName, "url": p.manufacturerUrl },
	"model": site.brand.model,
	"productionDate": site.brand.year,
	"category": p.category,
	"itemCondition": p.itemCondition,
	"additionalProperty": p.properties.map((prop: { name: string; value: string }) => ({
		"@type": "PropertyValue", "name": prop.name, "value": prop.value,
	})),
	"offers": {
		"@type": "Offer",
		"priceCurrency": p.priceCurrency,
		"price": p.price,
		"priceValidUntil": p.priceValidUntil,
		"availability": p.availability,
		"itemCondition": p.itemCondition,
		"businessFunction": "https://schema.org/Sell",
		"url": `${SITE_URL}/contact/`,
		"seller": {
			"@type": "Person",
			"name": p.sellerName,
			"url": `${SITE_URL}/about/`
		}
	}
};

// WebSite schema — helps Google understand the site and can enable sitelinks search box.
const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"@id": `${SITE_URL}#website`,
	"url": SITE_URL,
	"name": site.seo.website.name,
	"description": site.seo.website.description,
	"inLanguage": site.seo.website.inLanguage
};
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
{/* ⚠️ THE STAGING NOINDEX MANDATE, SIGNAL ONE OF THREE. The other two are
    X-Robots-Tag in public/_headers and Disallow in the robots.txt endpoint, and
    scripts/target-noindex.mjs ASSERTS all three on a staging build and asserts
    their removal on a production one — in both directions, because a production
    page quietly carrying noindex is the same size of mistake. The default here
    is staging, so a build that forgets to say which target it is for comes out
    noindex (src/lib/target.js). */}
<meta name="robots" content={IS_PROD ? site.seo.robots : 'noindex, nofollow'} />
<!-- Preload the two critical font subsets (Cormorant 400 latin + Raleway 400 latin).
     Pulled out of the CSS @font-face chain so they fetch alongside the HTML. -->
<link rel="preload" href="/fonts/co3bmX5slCNuHLi8bLeY9MK7whWMhyjYqXtKky2F7g.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/1Ptug8zYS_SKggPNyC0IT4ttDfA.woff2" as="font" type="font/woff2" crossorigin />

<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32-v2.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16-v2.png" />
<link rel="icon" href="/favicon-v2.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-v2.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.seo.ogSiteName} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:secure_url" content={ogImageURL} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={site.seo.ogImageAlt} />
<meta property="og:locale" content="en_US" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageURL} />

<!-- Schema.org — Product (the boat itself) -->
<script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

<!-- Schema.org — WebSite -->
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

<!-- Schema.org — Page-specific (FAQPage, BreadcrumbList, etc.) -->
{extraSchema && (
	<script type="application/ld+json" set:html={JSON.stringify(extraSchema)} />
)}
