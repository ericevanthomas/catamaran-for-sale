---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { getEntry, render } from 'astro:content';
import site from '../config/site.config.js';

// The prose is still markdown and still goes through Astro's own processor —
// the body just comes out of a `block` row now instead of
// src/content/pages/about.md (src/lib/prose.js). Everything around it that used
// to be typed into this template is `pageCopy.about`.
const page = await getEntry('prose', 'about');
const { Content } = page ? await render(page) : { Content: null };
const c = site.pageCopy.about;
---

<BaseLayout title={c.title} description={c.description}>

	<section class="page-header" data-rp-section="aboutHeader" data-rp-section-name="The opening">
		<div class="wrap">
			<h1 class="eyebrow page-header__h1" data-rp-field="pageCopy.about.eyebrow" data-rp-kind="text" data-rp-label="Eyebrow">{c.eyebrow}</h1>
			<p class="page-title" data-rp-field="pageCopy.about.h1" data-rp-kind="text" data-rp-label="Heading">{c.h1}</p>
		</div>
	</section>

	<section class="about-body" data-rp-section="aboutBody" data-rp-section-name="Who you are">
		<div class="wrap about-body__grid">
			{/* The photograph goes through <ResponsiveImage>, so the FILE could be
			    swapped by a picker; its description is a field. Marked `fixed`
			    rather than left bare because /about has exactly one photograph
			    and choosing a different one is a decision about the page, not a
			    caption fix — the drawer says so and offers to do it. */}
			<figure class="about-body__photo" data-rp-fixed="photo" data-rp-label="The family photograph">
				<ResponsiveImage
					src={c.photo}
					alt={c.photoAlt}
					sizes="(min-width: 900px) 480px, 100vw"
					loading="eager"
				/>
			</figure>
			<div class="about-body__text prose" data-rp-field="prose.about" data-rp-kind="rich" data-rp-label="About us">
				{Content && <Content />}
			</div>
		</div>
	</section>

	<section class="section section--alt" data-rp-section="aboutPosition" data-rp-section-name="Where the boat is">
		<div class="wrap">
			<p class="eyebrow" data-rp-field="pageCopy.about.positionEyebrow" data-rp-kind="text" data-rp-label="Eyebrow">{c.positionEyebrow}</p>
			<h2 data-rp-field="pageCopy.about.positionHeading" data-rp-kind="text" data-rp-label="Heading">{c.positionHeading}</h2>
			<p class="widget-note" data-rp-field="pageCopy.about.positionNote" data-rp-kind="text" data-rp-label="Note">{c.positionNote}</p>
			{/* A third-party tracking page. The address is not a field: it is a
			    Predictwind URL tied to the boat's own tracker, and a typo in it
			    is a blank panel with nothing to say why. */}
			<div class="predictwind-widget" data-rp-fixed="embed" data-rp-label="The live tracker">
				<iframe src={c.positionEmbed} width="100%" height="500" frameborder="0" loading="lazy" allow="geolocation"></iframe>
			</div>
		</div>
	</section>

	<section class="cta" data-rp-section="aboutCta" data-rp-section-name="The invitation">
		<div class="wrap cta__inner">
			<h2 data-rp-field="pageCopy.about.ctaHeading" data-rp-kind="text" data-rp-label="Heading">{c.ctaHeading}</h2>
			<p data-rp-field="pageCopy.about.ctaBody" data-rp-kind="rich" data-rp-label="Paragraph">{c.ctaBody}</p>
			<a href={c.ctaHref} class="btn btn--primary" data-rp-field="pageCopy.about.ctaLabel" data-rp-kind="text" data-rp-label="Button">{c.ctaLabel}</a>
		</div>
	</section>
</BaseLayout>

<style>
	.wrap {
		max-width: 1280px;
		margin: 0 auto;
		padding-left: var(--gap-l);
		padding-right: var(--gap-l);
	}

	/* Page header — matches Features, Specs, Gallery, FAQ */
	.page-header {
		padding-top: clamp(80px, 14vw, 120px);
		padding-bottom: var(--gap-l);
		background: var(--color-bg-warm);
	}

	.page-header__h1 {
		display: block;
		margin: 0;
	}

	.page-title {
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 4vw, 3.5rem);
		font-weight: 600;
		color: var(--color-heading);
		line-height: 1.15;
		letter-spacing: -0.01em;
		margin-top: var(--gap-s);
		margin-bottom: var(--gap-s);
	}

	.page-header__sub {
		font-size: var(--text-md);
		color: var(--color-text-muted);
		max-width: 50ch;
		margin: 0;
	}

	/* Body: photo + text */
	.about-body {
		padding: var(--space-3xl) 0;
	}

	.about-body__grid {
		display: grid;
		grid-template-columns: 1fr 1.25fr;
		gap: clamp(var(--gap-l), 6vw, 88px);
		align-items: start;
	}

	.about-body__photo {
		margin: 0;
		position: sticky;
		top: 100px;
	}

	.about-body__photo img {
		width: 100%;
		height: auto;
		display: block;
		border-radius: 6px;
		box-shadow: 0 18px 40px -20px rgba(10, 25, 40, 0.35);
	}

	.about-body__text :global(h2) {
		font-size: clamp(1.6rem, 2.4vw, 2rem);
		font-weight: 600;
		margin: 0 0 var(--gap-m);
		letter-spacing: -0.005em;
	}

	.about-body__text :global(p) {
		font-size: var(--text-md);
		line-height: 1.75;
		color: var(--color-text);
		margin: 0 0 var(--gap-m);
		max-width: 58ch;
	}

	.about-body__text :global(p:last-child) {
		margin-bottom: 0;
	}

	.about-body__text :global(a) {
		color: var(--color-accent);
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-thickness: 1px;
	}

	/* Location widget */
	.section {
		padding: var(--space-3xl) 0;
	}
	.section--alt { background: var(--color-bg-warm); }

	.widget-note {
		color: var(--color-text-muted);
		margin-bottom: var(--gap-m);
	}

	.predictwind-widget {
		overflow: hidden;
		min-height: 400px;
		background: var(--color-bg);
		border-radius: 4px;
	}

	/* CTA */
	.cta {
		background: var(--color-bg-dark);
		padding: var(--size-12) 0;
	}
	.cta__inner { text-align: center; }
	.cta__inner h2 {
		color: #fff;
		font-weight: 600;
		margin-bottom: var(--gap-s);
	}
	.cta__inner p {
		color: rgba(255, 255, 255, 0.5);
		font-size: var(--text-md);
		max-width: 45ch;
		margin: 0 auto var(--gap-m);
	}

	@media (max-width: 900px) {
		.about-body__grid {
			grid-template-columns: 1fr;
			gap: var(--gap-l);
		}
		.about-body__photo {
			position: static;
			max-width: 460px;
			margin: 0 auto;
		}
	}

	@media (max-width: 600px) {
		.wrap {
			padding-left: var(--gap-m);
			padding-right: var(--gap-m);
		}
		.page-header {
			padding-top: 80px;
		}
	}
</style>
