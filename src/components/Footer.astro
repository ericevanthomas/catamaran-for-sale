---
// The bar at the bottom, out of this tenant's own database.
//
// The disclaimer is the one paragraph on this site with legal weight — it is the
// owners' statement about the accuracy of the specifications — so it is content
// the owner can read and change, not a string in a template they would have to
// ask us about.
import site from '../config/site.config.js';

const phone = site.contact.phone;
const year = new Date().getFullYear();
---

<footer id="site-footer" data-rp-section="footer" data-rp-section-name="The bar at the bottom">
	<div class="footer-inner">
		<div class="footer-grid">
			<div class="footer-col footer-col--brand">
				<span class="footer-logo" data-rp-field="brand.footerLogo" data-rp-kind="text" data-rp-label="Name">{site.brand.footerLogo}</span>
				<p class="footer-tagline">{site.brand.footerTaglineLines.map((line: string, i: number, all: string[]) => (
					<>
						<span data-rp-field={`brand.footerTaglineLines.${i}`} data-rp-kind="text" data-rp-label="Line">{line}</span>
						{i < all.length - 1 && <br />}
					</>
				))}</p>
			</div>

			<div class="footer-col">
				<h4 class="footer-heading" data-rp-field="footer.contactHeading" data-rp-kind="text" data-rp-label="Heading">{site.footer.contactHeading}</h4>
				<ul class="footer-links">
					{site.footer.contactLinks.map((l: { href: string; label: string }, i: number) => (
						<li><a href={l.href} data-rp-field={`footer.contactLinks.${i}.label`} data-rp-kind="text" data-rp-label="Link">{l.label}</a></li>
					))}
					{phone && <li><a href={`tel:${phone}`} data-rp-field="contact.phone" data-rp-kind="text" data-rp-label="Phone">{phone}</a></li>}
				</ul>
			</div>

			<div class="footer-col">
				<h4 class="footer-heading" data-rp-field="footer.resourcesHeading" data-rp-kind="text" data-rp-label="Heading">{site.footer.resourcesHeading}</h4>
				<ul class="footer-links">
					{site.footer.resourceLinks.map((l: { href: string; label: string; external?: boolean }, i: number) => (
						<li><a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}
							data-rp-field={`footer.resourceLinks.${i}.label`} data-rp-kind="text" data-rp-label="Link">{l.label}</a></li>
					))}
				</ul>
			</div>
		</div>

		<div class="footer-disclaimer">
			<p data-rp-field="footer.disclaimer" data-rp-kind="rich" data-rp-label="Disclaimer">{site.footer.disclaimer}</p>
		</div>

		{/* The year counts itself, which is why the paragraph is `auto` and the
		    two editable parts of it carry their own addresses inside. */}
		<div class="footer-bottom">
			<p data-rp-auto data-rp-label="The year updates itself">&copy; {year} <span data-rp-field="footer.copyrightName" data-rp-kind="text" data-rp-label="Name">{site.footer.copyrightName}</span>. <span data-rp-field="footer.copyrightSuffix" data-rp-kind="text" data-rp-label="Line">{site.footer.copyrightSuffix}</span></p>
		</div>
	</div>
</footer>

<style>
	#site-footer {
		background-color: var(--color-bg-dark);
		color: rgba(255, 255, 255, 0.55);
		padding: var(--space-3xl) 0 var(--space-lg);
	}

	.footer-inner {
		max-width: 1280px;
		margin: 0 auto;
		padding-left: var(--gap-l);
		padding-right: var(--gap-l);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.5fr 1fr 1fr;
		gap: var(--space-2xl);
		margin-bottom: var(--space-2xl);
	}

	.footer-logo {
		font-family: var(--font-display);
		font-size: 1.4rem;
		font-weight: 400;
		letter-spacing: 5px;
		color: #ffffff;
		display: block;
		margin-bottom: var(--space-xs);
	}

	.footer-tagline {
		font-size: var(--size-sm);
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.4);
	}

	.footer-heading {
		font-family: var(--font-body);
		font-size: var(--size-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 2px;
		color: rgba(255, 255, 255, 0.7);
		margin-bottom: var(--space-sm);
	}

	.footer-links {
		list-style: none;
		padding: 0;
	}

	.footer-links li {
		margin-bottom: 8px;
	}

	.footer-links a {
		color: rgba(255, 255, 255, 0.5);
		font-size: var(--size-sm);
		transition: color var(--transition);
	}

	.footer-links a:hover {
		color: #ffffff;
	}

	.footer-disclaimer {
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		padding-top: var(--space-lg);
		margin-bottom: var(--space-lg);
	}

	.footer-disclaimer p {
		font-size: var(--size-xs);
		line-height: 1.7;
		max-width: 70ch;
		color: rgba(255, 255, 255, 0.3);
	}

	.footer-bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.06);
		padding-top: var(--space-sm);
	}

	.footer-bottom p {
		font-size: var(--size-xs);
		color: rgba(255, 255, 255, 0.25);
	}

	@media (max-width: 768px) {
		.footer-grid {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
		}
	}
</style>
