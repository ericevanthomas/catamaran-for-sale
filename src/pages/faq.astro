---
import BaseLayout from '../layouts/BaseLayout.astro';
import { marked } from 'marked';
import site from '../config/site.config.js';

const mdInline = (s: string) => {
	const html = marked.parseInline(s, { async: false }) as string;
	return html.replace(/<a (?![^>]*target=)([^>]*)>/g, '<a $1 target="_blank" rel="noopener">');
};

// The questions are `faq` rows; WHICH of them this page shows, and in what
// order, is the `block_pick` set on the `faq:list` block — a picker over the
// pool, never a retype (EDITOR-RULES §4.1). assemble() has already resolved the
// picks, so `site.faqs` is the page's list in the page's order, and the sort
// below is on the question's own `order` number, which is a different fact.
type Faq = typeof site.faqs[number];
const c = site.pageCopy.faq;
// In PICK ORDER, not sorted here. `site.faqs` is already the `block_pick` set
// resolved in its own order, which is what makes the editor's question picker a
// control that changes the page.
const faqs = site.faqs;

const categoryOrder = c.categoryOrder;
const grouped = faqs.reduce((acc, faq) => {
	const cat = faq.category || 'General';
	if (!acc[cat]) acc[cat] = [];
	acc[cat].push(faq);
	return acc;
}, {} as Record<string, Faq[]>);

const sortedCategories = Object.entries(grouped).sort(([a], [b]) => {
	const ai = categoryOrder.indexOf(a);
	const bi = categoryOrder.indexOf(b);
	return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
});

// FAQPage schema for SEO
const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqs.map((f) => ({
		"@type": "Question",
		"name": f.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": f.answer,
		},
	})),
};
---

<BaseLayout title={c.title} description={c.description} schema={faqSchema}>
	<section class="page-header" data-rp-section="faqHeader" data-rp-section-name="The opening">
		<div class="wrap">
			<p class="eyebrow" data-rp-field="pageCopy.faq.eyebrow" data-rp-kind="text" data-rp-label="Eyebrow">{c.eyebrow}</p>
			<h1 data-rp-field="pageCopy.faq.h1" data-rp-kind="text" data-rp-label="Heading">{c.h1}</h1>
			<p class="page-header__sub" data-rp-field="pageCopy.faq.sub" data-rp-kind="text" data-rp-label="Opening line">{c.sub}</p>
		</div>
	</section>

	{/* WHICH questions appear, and in what order, is the picker: the container
	    carries `ids`, the pool is `faqs` in rp-records.json, and the save writes
	    `block_pick` on the `faq:list` block. The GROUP HEADINGS are not fields —
	    each one is the name of a category the questions are filed under, so
	    renaming it here would empty the group rather than rename it. Changing a
	    question's group is a field on the question. */}
	<section class="faq-section" data-rp-section="faqList" data-rp-section-name="The questions"
		data-rp-field="faqIds" data-rp-kind="ids" data-rp-record="faqs" data-rp-label="Questions">
		<div class="wrap">
			{sortedCategories.map(([category, items]) => (
				<div class="faq-group">
					<h2 class="faq-group__title" data-rp-auto data-rp-label="The group these questions are filed under">{category}</h2>
					{category === c.disclosureCategory && (
						<a href={c.disclosureHref} class="faq-download" target="_blank" rel="noopener"
							data-rp-field="pageCopy.faq.disclosureLabel" data-rp-kind="text" data-rp-label="Download link">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
							<span>{c.disclosureLabel}</span>
						</a>
					)}
					{items.map((item) => (
						<details class="faq-item" data-rp-item={`faqs.${item.id}`}>
							<summary class="faq-item__q">
								<span class="faq-item__qtext">
									<span data-rp-field={`faqs.${item.id}.question`} data-rp-kind="text" data-rp-label="Question">{item.question}</span>
									{item.download && <span class="faq-item__pill" data-rp-field="pageCopy.faq.pillLabel" data-rp-kind="text" data-rp-label="Badge">{c.pillLabel}</span>}
								</span>
								<span class="faq-item__icon" aria-hidden="true">+</span>
							</summary>
							<div class="faq-item__a">
								<p data-rp-field={`faqs.${item.id}.answer`} data-rp-kind="rich" data-rp-label="Answer" set:html={mdInline(item.answer)}></p>
								{item.download && (
									<a href={item.download.url} class="faq-download faq-download--inline" target="_blank" rel="noopener"
										data-rp-fixed="document" data-rp-label="The document this answer offers">
										<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
										<span>{item.download.label}</span>
									</a>
								)}
							</div>
						</details>
					))}
				</div>
			))}
		</div>
	</section>

	<section class="faq-cta" data-rp-section="faqCta" data-rp-section-name="The invitation">
		<div class="wrap faq-cta__inner">
			<h2 data-rp-field="pageCopy.faq.ctaHeading" data-rp-kind="text" data-rp-label="Heading">{c.ctaHeading}</h2>
			<p data-rp-field="pageCopy.faq.ctaBody" data-rp-kind="rich" data-rp-label="Paragraph">{c.ctaBody}</p>
			<a href={c.ctaHref} class="btn btn--primary" data-rp-field="pageCopy.faq.ctaLabel" data-rp-kind="text" data-rp-label="Button">{c.ctaLabel}</a>
		</div>
	</section>

</BaseLayout>

<style>
	.wrap {
		max-width: 1280px;
		margin: 0 auto;
		padding-left: var(--gap-l);
		padding-right: var(--gap-l);
	}

	.page-header {
		padding-top: clamp(80px, 14vw, 120px);
		padding-bottom: var(--gap-l);
		background: var(--color-bg-warm);
	}

	.page-header h1 {
		font-size: clamp(2.5rem, 4vw, 3.5rem);
		font-weight: 600;
		margin-top: var(--gap-s);
		margin-bottom: var(--gap-s);
	}

	.page-header__sub {
		font-size: var(--text-md);
		color: var(--color-text-muted);
		max-width: 50ch;
		margin: 0;
	}

	/* FAQ sections */
	.faq-section {
		padding: var(--gap-l) 0 var(--size-12);
	}

	.faq-group {
		margin-bottom: var(--gap-l);
	}

	.faq-group:last-child {
		margin-bottom: 0;
	}

	.faq-group__title {
		font-size: var(--text-xl);
		font-weight: 600;
		color: var(--color-heading);
		padding-bottom: var(--gap-s);
		border-bottom: 2px solid var(--color-accent);
		margin-bottom: 0;
	}

	.faq-download {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		margin-top: var(--gap-m);
		margin-bottom: var(--gap-s);
		padding: 10px 18px;
		background: var(--color-accent);
		color: #fff;
		text-decoration: none;
		border-radius: 3px;
		font-size: var(--text-sm);
		font-weight: 600;
		letter-spacing: 0.3px;
		transition: background 0.2s;
	}
	.faq-download:hover {
		background: var(--color-accent-dark);
	}
	.faq-download svg {
		flex-shrink: 0;
	}

	/* Inline variant inside an open FAQ accordion */
	.faq-item__a a.faq-download--inline {
		display: inline-flex;
		margin-top: var(--gap-m);
		margin-bottom: 0;
		padding: 8px 14px;
		font-size: 13px;
		color: #fff;
		text-decoration: none;
	}
	.faq-item__a a.faq-download--inline:hover {
		color: #fff;
		background: var(--color-accent-dark);
	}

	/* PDF marker pill on question titles that have a download */
	.faq-item__qtext {
		display: inline-flex;
		align-items: center;
		gap: var(--gap-s);
		flex: 1;
		min-width: 0;
	}

	.faq-item__pill {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 2px 8px;
		border-radius: 999px;
		background: var(--color-accent);
		color: #fff;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.6px;
		text-transform: uppercase;
		line-height: 1.4;
		flex-shrink: 0;
	}

	/* Accordion items */
	.faq-item {
		border-bottom: 1px solid var(--color-border-light);
	}

	.faq-item__q {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: var(--size-4) 0;
		cursor: pointer;
		font-family: var(--font-body);
		font-size: var(--text-base);
		font-weight: 600;
		color: var(--color-heading);
		list-style: none;
		transition: color 0.2s;
	}

	.faq-item__q::-webkit-details-marker { display: none; }

	.faq-item__q:hover {
		color: var(--color-accent);
	}

	.faq-item__icon {
		font-size: var(--text-xl);
		font-weight: 300;
		color: var(--color-text-muted);
		transition: transform 0.2s;
		flex-shrink: 0;
		margin-left: var(--gap-m);
	}

	.faq-item[open] .faq-item__icon {
		transform: rotate(45deg);
	}

	.faq-item__a {
		padding: 0 0 var(--size-4);
	}

	.faq-item__a p {
		font-size: var(--text-sm);
		color: var(--color-text-muted);
		line-height: 1.7;
		max-width: 65ch;
		margin: 0;
	}

	.faq-item__a a {
		color: var(--color-accent);
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-thickness: 1px;
	}

	/* CTA */
	.faq-cta {
		background: var(--color-bg-dark);
		padding: var(--size-12) 0;
	}

	.faq-cta__inner {
		text-align: center;
	}

	.faq-cta__inner h2 {
		color: #fff;
		font-weight: 600;
		margin-bottom: var(--gap-s);
	}

	.faq-cta__inner p {
		color: rgba(255,255,255,0.4);
		font-size: var(--text-md);
		max-width: 45ch;
		margin: 0 auto var(--gap-m);
	}

	@media (max-width: 600px) {
		.wrap { padding-left: var(--gap-m); padding-right: var(--gap-m); }
		.page-header { padding-top: clamp(80px, 14vw, 120px); }
	}
</style>
