---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { getEntry, render } from 'astro:content';
import site from '../config/site.config.js';

const page = await getEntry('prose', 'contact');
const { Content } = page ? await render(page) : { Content: null };
const c = site.pageCopy.contact;
const phone = site.contact.phone;
---

<BaseLayout title={c.title} description={c.description}>
	<section class="page-header" data-rp-section="contactHeader" data-rp-section-name="The opening">
		<div class="wrap">
			<h1 class="eyebrow page-header__h1" data-rp-field="pageCopy.contact.eyebrow" data-rp-kind="text" data-rp-label="Eyebrow">{c.eyebrow}</h1>
			<p class="page-title" data-rp-field="pageCopy.contact.h1" data-rp-kind="text" data-rp-label="Heading">{c.h1}</p>
			<p class="page-header__sub" data-rp-field="pageCopy.contact.sub" data-rp-kind="text" data-rp-label="Opening line">{c.sub}</p>
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<div class="contact-layout">
				<div class="contact-form-col">
					<div class="prose" data-rp-field="prose.contact" data-rp-kind="rich" data-rp-label="Opening line">
						{Content && <Content />}
					</div>
					<ContactForm />
				</div>
				<div class="contact-info-col" data-rp-section="contactAside" data-rp-section-name="Beside the form">
					<h3 data-rp-field="pageCopy.contact.sideHeading" data-rp-kind="text" data-rp-label="Heading">{c.sideHeading}</h3>
					<p data-rp-field="pageCopy.contact.sideBody" data-rp-kind="rich" data-rp-label="Paragraph">{c.sideBody}</p>
					{phone && <p><a href={`tel:${phone}`} data-rp-field="contact.phone" data-rp-kind="text" data-rp-label="Phone">{phone}</a></p>}
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.page-header {
		padding-top: clamp(80px, 14vw, 120px);
		padding-bottom: var(--gap-l);
		background: var(--color-bg-warm);
	}

	.page-header__h1 {
		display: block;
		margin: 0;
	}

	.page-title {
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 4vw, 3.5rem);
		font-weight: 600;
		color: var(--color-heading);
		line-height: 1.15;
		letter-spacing: -0.01em;
		margin-top: var(--gap-s);
		margin-bottom: var(--gap-s);
	}

	.page-header__sub {
		font-size: var(--text-md);
		color: var(--color-text-muted);
		max-width: 50ch;
		margin: 0;
	}

	.wrap {
		max-width: 1280px;
		margin: 0 auto;
		padding-left: var(--gap-l);
		padding-right: var(--gap-l);
	}

	.section {
		padding: clamp(1.5rem, 6vw, 7rem) 0;
	}

	.contact-layout {
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: clamp(2rem, 6vw, 7rem);
	}

	.contact-info-col h3 {
		margin-bottom: var(--space-sm);
	}

	.contact-info-col p {
		margin-bottom: var(--space-xs);
	}

	@media (max-width: 768px) {
		.contact-layout {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 600px) {
		.wrap {
			padding-left: var(--gap-m);
			padding-right: var(--gap-m);
		}
		.page-header {
			padding-top: 80px;
		}
		.section {
			padding: var(--gap-l) 0;
		}
		.contact-layout {
			gap: var(--gap-l);
		}
	}
</style>
